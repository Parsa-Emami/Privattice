{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:privattice:input:0",
  "title": "inventory-snapshot planning draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "snapshot_id",
    "source",
    "observed_at",
    "entities",
    "relationships"
  ]
}
